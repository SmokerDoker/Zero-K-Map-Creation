{
  "name": "@zk-map/desktop",
  "private": true,
  "version": "0.0.1",
  "description": "Zero-K Map Creator desktop application",
  "license": "GPL-2.0-only",
  "author": "SmokerDoker",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist:win": "electron-vite build && electron-builder --win --publish never",
    "dist:mac": "electron-vite build && electron-builder --mac --publish never",
    "dist:linux": "electron-vite build && electron-builder --linux --publish never"
  },
  "dependencies": {
    "@zk-map/shared-types": "workspace:*",
    "@zk-map/map-lua": "workspace:*",
    "@zk-map/smf-format": "workspace:*",
    "@zk-map/zk-locator": "workspace:*",
    "@react-three/drei": "^9.114.0",
    "@react-three/fiber": "^8.17.10",
    "three": "^0.169.0",
    "node-7z": "^3.0.0",
    "7zip-bin": "^5.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.0",
    "@types/three": "^0.169.0",
    "@types/node-7z": "^2.1.10"
  }
}
